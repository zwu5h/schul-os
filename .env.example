# Server-only. Never use NEXT_PUBLIC_ for secrets.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Cloud sync (Supabase). Use the public publishable key, never a secret/service_role key.
# Instructions: docs/SUPABASE.md. These values must be present at build time.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects can use an anon key instead of the publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Self-hosted account access. APP_URL must be the exact public origin.
APP_URL=http://127.0.0.1:3000
AUTH_SECRET=
AUTH_DATABASE_PATH=data/auth.sqlite
# Optional frontend hosting with an existing persistent School OS server.
# Vercel defaults to https://os.digmio.app; self-hosted installs use local SQLite.
SCHOOL_OS_BACKEND_URL=
# Password reset email (server-only). Restart the app after changing these.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Require STARTTLS on port 587. Disable only for a local test mail server.
SMTP_REQUIRE_TLS=true
# Used by Caddy in Docker Compose; set to a DNS name pointing to the Oracle public IP.
APP_HOST=school.example.at
