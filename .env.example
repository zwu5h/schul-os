# Server-only. Never use NEXT_PUBLIC_ for secrets.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Cloud-Backend (Supabase). Public anon key is safe to expose; service_role never belongs here.
# Without these two, the app runs fully local and the account section shows a setup hint.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Self-hosted account access. APP_URL must be the exact public origin.
APP_URL=http://127.0.0.1:3000
AUTH_SECRET=
AUTH_DATABASE_PATH=data/auth.sqlite
# Used by Caddy in Docker Compose; set to a DNS name pointing to the Oracle public IP.
APP_HOST=school.example.at
