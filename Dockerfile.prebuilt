# Build .next on Linux x64 with Node 22 from this exact package-lock.json.
# Use the same Node major version as the tested local build.
FROM node:22-bookworm-slim
ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
WORKDIR /app
RUN groupadd -r school && useradd -r -g school -d /app school
COPY --chown=school:school .next/standalone ./
COPY --chown=school:school .next/static ./.next/static
COPY public ./public
COPY scripts ./scripts
COPY migrations ./migrations
RUN mkdir -p /app/data && chown school:school /app/data
USER school
EXPOSE 3000
CMD ["sh", "-c", "node scripts/migrate.mjs && node server.js"]
